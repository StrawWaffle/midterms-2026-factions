---
import '../styles/site.css';
import { VERSION } from '../lib/version';
import { entities } from '../lib/entities';

export interface TocItem { id: string; title: string; level: 2 | 3 }
interface Props { title: string; description: string; toc: TocItem[]; heading?: string }
const { title, description, toc, heading = 'Did moderates win the 2026 midterms?' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
  </script>
</head>
<body data-base={base} data-vdata={VERSION.data} data-vcode={VERSION.code} data-vcalled={VERSION.called}>
  <div class="layout">
    <aside class="toc" aria-label="On this page">
      <div class="toc-inner">
        <a class="toc-top" href="#top">{heading}</a>
        <ol>{toc.map((t) => <li class={`toc-h${t.level}`}><a href={`#${t.id}`}>{t.title}</a></li>)}</ol>
      </div>
    </aside>
    <main id="top"><slot /></main>
  </div>
  <div id="selbar" role="status" aria-live="polite">
    <div class="in"><strong></strong><span class="facts"></span><span class="facts where"></span><button type="button">Clear</button></div>
  </div>
  <div id="tip" role="tooltip"></div>
  <script type="application/json" id="entities" set:html={JSON.stringify(entities)} />
  <script>import '../scripts/app';</script>
  <script>import '../scripts/version';</script>
</body>
</html>
