---
import Base, { type TocItem } from '../layouts/Base.astro';
import F from '../components/F.astro';
import Quote from '../components/Quote.astro';
import H from '../components/H.astro';
import Figure from '../components/Figure.astro';
import HouseStrip from '../components/HouseStrip.astro';
import FlipsChart from '../components/FlipsChart.astro';
import StateScatter from '../components/StateScatter.astro';
import PairsChart from '../components/PairsChart.astro';
import ForestChart from '../components/ForestChart.astro';
import SenateMoneyChart from '../components/SenateMoneyChart.astro';
import HouseMoneyChart from '../components/HouseMoneyChart.astro';
import {
  seats, races, houseMeanAll, group, flips, flipCount, flipsUnder, flipsBy, flipsUncalled, lostClose, uncounted, uncalled, seatByCode,
  houseModels, nStrictProg, nStrictMod, senateCompetitive, swingSlope, pairs, pairSummary, pairSummaryConfident, statewideModel, LCN_PARTY_SHARE, thirdWay,
  senateMoneyRows, senateMoneyBy, houseMoneyRows, houseMoneyBy, houseMoneyMedian, redToBlue, nobodyHelped, receipts, forest,
} from '../lib/analysis';
import { entities } from '../lib/entities';
import { FACTION, HOUSE_ROWS } from '../lib/factions';
import { signed, fixed, usd, millions, interval, pct } from '../lib/format';
import { mean } from '../lib/stats';

const toc: TocItem[] = [
  { id: 'measure', title: 'How to compare candidates fairly', level: 2 },
  { id: 'tide', title: 'The wave lifted every faction', level: 2 },
  { id: 'where', title: 'Moderates ran where the seats were', level: 2 },
  { id: 'flips', title: 'Would progressives have won those seats?', level: 2 },
  { id: 'house', title: 'Seat for seat, no clear House gap', level: 2 },
  { id: 'statewide', title: 'Statewide, progressives ran a few points behind', level: 2 },
  { id: 'same-ballot', title: 'A closer test: two Democrats on one ballot', level: 3 },
  { id: 'michigan', title: 'Michigan: real penalties, and not only ideology', level: 3 },
  { id: 'estimates', title: 'Every estimate in one place', level: 2 },
  { id: 'hasan', title: "What this means for Hasan's argument", level: 2 },
  { id: 'primaries', title: 'Why progressives rarely win swing-seat primaries', level: 2 },
  { id: 'leaders', title: 'Did Schumer and Jeffries work against progressives?', level: 2 },
  { id: 'schumer', title: 'Schumer picked sides with words and small checks', level: 3 },
  { id: 'schumer-defense', title: "Schumer's defense, checked", level: 3 },
  { id: 'jeffries', title: 'Jeffries backed incumbents, then the winners', level: 3 },
  { id: 'leader-claims', title: 'How the accusations against the leaders hold up', level: 3 },
  { id: 'leadership-fights', title: 'The fallout: a challenge to Schumer, not to Jeffries', level: 3 },
  { id: 'hasan-schumer', title: "Hasan's case against Schumer", level: 3 },
  { id: 'money', title: 'Did the party fund its progressive nominees?', level: 2 },
  { id: 'senate-money', title: 'Senate: the money followed the target map', level: 3 },
  { id: 'house-money', title: 'House: progressives in target seats got more, not less', level: 3 },
  { id: 'progressive-groups', title: 'Progressive groups barely spent in general elections', level: 3 },
  { id: 'claims', title: 'How the money claims hold up', level: 3 },
  { id: 'conclusion', title: 'Putting it together', level: 2 },
  { id: 'data', title: 'Data, method and limits', level: 2 },
  { id: 'sources', title: 'Sources', level: 2 },
];
const T = (id: string) => toc.find((t) => t.id === id)!.title;

const ahead = (est: number) => (est >= 0 ? 'ahead of' : 'behind');
const g = { mod: group('moderate'), both: group('both'), prog: group('progressive'), none: group('unflagged') };
const pair = (st: string) => pairs.find((p) => p.prog.st === st)!;
const [MI, MN, ME, OR, MA] = ['MI', 'MN', 'ME', 'OR', 'MA'].map(pair);
const swingOf = (st: string) => races.find((r) => r.st === st && r.office === 'Senate')!.swing;
const modCompetitiveMean = mean(senateCompetitive.moderate.map((r) => r.swing));
const iaPair = (() => { const s = races.find((r) => r.st === 'IA' && r.office === 'Senate')!, gv = races.find((r) => r.st === 'IA' && r.office === 'Governor')!; return Math.abs(s.margin - gv.margin); })();
const m = (st: string) => senateMoneyBy(st)!;
const share = (st: string) => (m(st).party / m(st).against) * 100;
const partyRank = [...senateMoneyRows].sort((a, b) => b.party - a.party).findIndex((r) => r.st === 'ME') + 1;
const ordinal = (n: number) => ['', 'highest', 'second-highest', 'third-highest'][n] ?? `${n}th-highest`;
const hm = (code: string) => houseMoneyBy(code)!;
const rtb = { prog: redToBlue('progressive'), mod: redToBlue('moderate'), none: redToBlue('unflagged') };
const nProgCompetitiveChallengers = houseMoneyRows.filter((r) => r.faction === 'progressive' && ['Toss-up', 'Lean'].includes(r.rating)).length;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const w = (n: number) => words[n] ?? String(n);
const Cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const thousands = (v: number) => '$' + Math.round(v / 1000) + ',000';
const MB: ('moderate' | 'both')[] = ['moderate', 'both'];
const houseLo = Math.min(houseModels.broadAll.est, houseModels.broadCompetitive.est, houseModels.strictAll.est, houseModels.strictNoOutliers.est, houseModels.strictControls.est);
const houseHi = Math.max(houseModels.broadAll.est, houseModels.broadCompetitive.est, houseModels.strictAll.est, houseModels.strictNoOutliers.est, houseModels.strictControls.est);
const houseRange = `from about ${Math.abs(Math.round(houseLo))} points ${houseLo < 0 ? 'behind' : 'ahead'} to ${Math.round(houseHi)} points ahead`;
const stateName = (st: string) => races.find((r) => r.st === st)!.state;
const orList = (xs: string[]) => xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs[xs.length - 1]}`;
const SWING_PRIMARY = ['CA-22', 'MI-07', 'ME-02', 'TN-09', 'VA-05'];
const swingPrimaryMean = mean(SWING_PRIMARY.map((c) => seatByCode(c).overperf));
const leanMods = houseMoneyRows.filter((r) => r.rating === 'Lean' && r.faction === 'moderate');
const miPartyAll = m('MI').partyTotal + (1 - LCN_PARTY_SHARE) * m('MI').lcn;
---
<Base title="Moderates, progressives and the 2026 wave"
  description="Did moderate or progressive Democrats drive the 2026 midterm wave? House, Senate and governor results compared against 2024, with the data."
  toc={toc}>
<button class="theme" type="button" id="theme">Dark mode</button>
<h1>Did moderates win the 2026 midterms?</h1>
<p class="dateline">A look at every House, Senate and governor race, first written November 14, 2026. Results are unofficial and some seats are still counting. The charts and the numbers computed from them update as counts and filings come in; the section on the party leaders is written by hand and was last checked on November 16.</p>
<p class="made"><strong>How this was made.</strong> An AI agent gathered the House and statewide results, the endorsement lists and the FEC spending files, coded each nominee's faction, ran the comparisons and regressions, drew the charts and wrote the text, with a person choosing the questions and reviewing each draft. Three separate AI reviewers then rechecked the numbers, the charts, and every quote and source, and their corrections are folded in. The numbers come from the data files and are recomputed when the data updates; quotes and figures from published analyses are entered by hand. The method and its limits are <a href="#data">at the bottom of the page</a>.</p>

<p>After Democrats' wave on November 3, a fight broke out over who deserves the credit. Centrist writers said moderate candidates ran ahead and progressives lagged. Mehdi Hasan answered in a video monologue for Zeteo, posted <a href="https://x.com/mehdirhasan/status/2121382704105267425">on X</a> and <a href="https://zeteo.com/p/debunked-mehdi-dismantles-the-myth">on Zeteo's site</a>:</p>
<Quote who="Mehdi Hasan" source="Zeteo video, at 0:44" href="https://x.com/mehdirhasan/status/2121382704105267425" when="November 13">It is complete and utter bullshit. Just totally out of context, cherry-picked numbers, and ridiculous comparisons dressed up as some sort of hard scientific evidence…</Quote>
<p>Two different questions get mixed up in that fight. One is what caused Democrats to do so well. The other is whether moderates do better than progressives in the same seat. A third argument runs alongside them: did the party, its leaders and its money stand behind progressive candidates, in the primaries and after? This page takes the three in that order, with the results of all {seats.length} House races that had a Democrat against a Republican, all {races.length} comparable Senate and governor races, federal spending filings, and every published analysis I could find.</p>

<div class="answer">
<p><strong>Short answer.</strong> The wave came from the national environment, and it lifted every faction by about {Math.round(houseMeanAll)} points. Whether <F f="moderate">moderates</F> run better than <F f="progressive">progressives</F> in the same kind of seat depends on the office. In House races the estimates run {houseRange} for moderates, and none can be told apart from zero. Statewide, the evidence points to a moderate edge of <strong>about 1 to 6 points</strong> of margin, but it rests on only {w(statewideModel.nProg)} progressive nominees. Either way the gap is small next to the wave. Moderates won most of the seats Democrats flipped mainly because moderates were the nominees in most of the seats that could flip. If every moderate who flipped a seat had run 3 points worse, {flipsUnder(3, MB)} of their {flipsBy(MB)} flips would have been reversed. In a close year a gap that size would matter far more.</p>
<p>On the primaries: Schumer and Jeffries did back moderates and incumbents in primaries, and mostly lost those bets, but their own super PACs stayed out of the primaries and the heavy spending against progressives came from other groups. <a href="#leaders">Details below.</a></p>
<p>On the money after the primaries: party groups put large sums behind progressive nominees in the races they targeted. In the House those nominees got as much per vote as moderates or more. In the Senate the party answered a smaller share of the attack spending against El-Sayed and Jackson than against most moderates. Races outside the target map were skipped whoever the nominee was. Progressive groups themselves spent very little in general elections. <a href="#money">Details below.</a></p>
</div>

<div class="find">
  <label for="find-input">Find a race</label>
  <input id="find-input" list="find-list" placeholder="A seat like CA-22, a state, or a candidate" autocomplete="off" />
  <datalist id="find-list">{entities.map((e) => <option value={e.label} />)}</datalist>
  <span class="help">Picks the race out in every chart below and keeps its numbers at the bottom of the screen. You can also click or tap any dot. Press a legend entry to highlight one faction everywhere. Escape clears.</span>
</div>

<nav aria-label="Contents">
<strong>Contents</strong>
<ol>{toc.filter((t) => t.level === 2).map((t) => <li><a href={`#${t.id}`}>{t.title}</a></li>)}</ol>
</nav>

<H id="measure">{T('measure')}</H>
<p>Raw winning margins tell you almost nothing about a candidate. A Democrat who wins a deep blue seat by 40 points hasn't outperformed one who wins a Trump seat by 2. So nearly every serious analysis starts from a baseline, and the usual one is the 2024 presidential result in the same seat. If Harris won a district by 5 and the 2026 Democrat won it by 20, that Democrat ran 15 points ahead of the baseline. This page calls that number the <em>swing</em> or <em>overperformance</em>.</p>
<p>Two complications matter throughout. First, seats that voted heavily for Trump in 2024 had more room to swing back, so red-seat candidates look better on this measure whatever their ideology. Second, "moderate" and "progressive" are labels someone has to assign. For House races I use endorsements and caucus membership. A nominee is <F f="progressive">progressive</F> if they belong to the Congressional Progressive Caucus or were endorsed by Justice Democrats, DSA, Bernie Sanders, Our Revolution or the Progressive Caucus PAC. A nominee is <F f="moderate">moderate</F> if they belong to or were endorsed by the New Democrat Coalition or the Blue Dogs, or were endorsed by WelcomePAC. Some nominees carry <F f="both">both flags</F> and many carry neither. A stricter version keeps only Justice Democrats, DSA and Sanders on one side and Blue Dogs and WelcomePAC on the other.</p>

<H id="tide">{T('tide')}</H>
<p>Across all {seats.length} contested House seats, the Democratic nominee ran an average of <strong>{houseMeanAll.toFixed(1)} points</strong> ahead of Harris's 2024 margin. Split by faction, the averages barely differ, and their 95% intervals overlap. <F f="moderate">Moderate-flagged</F> nominees ran {signed(g.mod.over.mean)}, nominees with <F f="both">both flags</F> {signed(g.both.over.mean)}, <F f="progressive">progressive-flagged</F> nominees {signed(g.prog.over.mean)}, and nominees with no flag {signed(g.none.over.mean)}.</p>
<Figure id="fig-tide" legend={HOUSE_ROWS} hint="Press to highlight"
  caption={`Each dot is one of ${seats.length} Democratic House nominees in a two-party race. The tick is each faction's mean and the shaded bar its 95% interval. Hover or tap a dot for the race; click it to mark the same seat in every chart. The far-right dots are heavily Hispanic seats in South Texas and the Central Valley.`}>
  <HouseStrip field="overperf" domain={[-10, 50]} step={10} stat="mean"
    axisLabel="How far the Democrat ran ahead of Harris's 2024 margin (points)" title="House overperformance by faction"
    desc="Strip plot of House races: each dot is one Democratic nominee, rows are factions, x is how far the nominee ran ahead of the 2024 presidential margin, with each faction's mean and 95% interval." />
  <table slot="table"><thead><tr><th>Faction</th><th>Nominees</th><th>Mean overperformance</th><th>95% interval</th><th>Median</th></tr></thead>
    <tbody>{HOUSE_ROWS.map((f) => { const x = group(f); return <tr><td>{FACTION[f].label}</td><td>{x.n}</td><td>{signed(x.over.mean)}</td><td>{interval(x.over.lo, x.over.hi)}</td><td>{signed(x.overMedian)}</td></tr>; })}</tbody></table>
</Figure>
<p>The wave was about Trump, not about Democrats' ideology. Trump's approval averaged 39 percent, and disapproval was higher than approval in all 11 competitive Senate states (<a href="https://www.brookings.edu/articles/how-democrats-won-big-and-why-2028-remains-an-open-question/">Brookings</a>). An early analysis of 13 states by Lenny Bronner of Broome Street Labs credits about 75 percent of the Democratic gain to the turnout gap between the parties' voters and about 20 percent to voters switching sides. Texas was the exception, with about 45 percent from switchers (<a href="https://michiganadvance.com/?p=115713">Stateline</a>). That estimate is preliminary. A turnout-driven wave doesn't make the nominee's ideology irrelevant, though: the research <a href="#estimates">below</a> finds that extreme nominees pay their penalty mainly by turning out the other party's voters.</p>
<p>The biggest overperformers sit at the far right of the chart, and almost all of them are in heavily Hispanic districts in South Texas and California's Central Valley. Henry Cuellar ran {seatByCode('TX-28').overperf.toFixed(1)} points ahead of the 2024 margin, Bobby Pulido {seatByCode('TX-15').overperf.toFixed(1)} and Randy Villegas {seatByCode('CA-22').overperf.toFixed(1)}. Cuellar and Pulido are Blue Dogs, and Villegas is a Sanders-backed progressive. AP's numbers show the Democratic vote share running about 11 points above Harris's in House districts that are at least a quarter Hispanic, against about 7 elsewhere. Those are share points; on this page's margin scale they are roughly double (<a href="https://www.ajc.com/news/2026/11/latino-voters-swing-left-in-midterm-elections-lifting-democrats-to-big-wins-in-texas-and-nationwide/">AP via the AJC</a>). That swing belonged to the districts, not the factions.</p>

<H id="where">{T('where')}</H>
<p>The factions did not run in the same places. Of the {g.prog.n} <F f="progressive">progressive-flagged</F> nominees, the median ran in a seat Harris won by {fixed(g.prog.presMedian)} points, only {g.prog.nCompetitive} ran in seats within 15 points, and {g.prog.nTrump} ran in seats Trump carried. Of the {g.mod.n} <F f="moderate">moderate-flagged</F> nominees, the median seat was {signed(g.mod.presMedian)}, {g.mod.nCompetitive} ran in competitive seats and {g.mod.nTrump} ran in Trump seats.</p>
<Figure id="fig-where" legend={HOUSE_ROWS} hint="Press to highlight"
  caption={`The same ${seats.length} nominees, placed by how their district voted in 2024. The tick is each faction's median. The shaded band is the competitive range. Seats beyond either end of the axis are drawn at the edge.`}>
  <HouseStrip field="pres24" domain={[-50, 90]} step={10} stat="median" band={[-15, 15, 'Competitive (within 15)']}
    axisLabel="2024 presidential margin in the district (Harris minus Trump)" title="Where each faction's nominees ran"
    desc="Strip plot of House races by 2024 presidential margin of the district, rows are factions, with the competitive range shaded." />
  <table slot="table"><thead><tr><th>Faction</th><th>Nominees</th><th>Median 2024 seat</th><th>In competitive seats</th><th>In Trump-won seats</th></tr></thead>
    <tbody>{HOUSE_ROWS.map((f) => { const x = group(f); return <tr><td>{FACTION[f].label}</td><td>{x.n}</td><td>{signed(x.presMedian)}</td><td>{x.nCompetitive}</td><td>{x.nTrump}</td></tr>; })}</tbody></table>
</Figure>
<p>This is why moderates won most of the flips. Democrats took {flips.length} seats that Republicans held. {flipCount('moderate')} went to <F f="moderate">moderate-flagged</F> nominees, {flipCount('both')} to nominees with <F f="both">both flags</F>, {flipCount('progressive')} to <F f="progressive">progressive-flagged</F> nominees ({flips.filter((s) => s.faction === 'progressive').map((s) => `${s.dem} in ${s.code}`).join(' and ')}) and {flipCount('unflagged')} to nominees with no flag. That count includes {w(flipsUncalled.length)} uncalled seats where the Democrat leads by a fraction of a point ({flipsUncalled.map((s) => s.code).join(', ')}). Third Way, in an early, partial count, presented this pattern as proof that <a href="https://www.thirdway.org/memo/moderates-made-democratic-majorities">"moderates made Democratic majorities."</a> In a literal sense they did. They were the ones on the ballot in the seats that decided the majority.</p>
<p>The count can't tell you whether a progressive would have done as well in those same seats, because progressives mostly weren't running there. The NewDem Action Fund endorsed nearly every serious challenger in a Trump-won or near-even seat, while progressive groups put most of their effort into open primaries in safe blue seats.</p>

<H id="flips">{T('flips')}</H>
<p>One way to answer is to ask how many flips were close enough for a small handicap to matter. Suppose a progressive nominee had run in each seat a moderate flipped, and done 3 points worse. That is about the size of the House edge in the more favourable published estimates; this page's own House estimates are smaller.</p>
<Figure id="fig-flips" legend={HOUSE_ROWS} hint="Press to highlight"
  caption="One dot per flipped seat, stacked in one-point bins, including uncalled seats where the Democrat leads. The shaded strip holds the seats won by under 3 points.">
  <FlipsChart />
  <table slot="table"><thead><tr><th>Seat</th><th>Democrat</th><th>Margin</th><th>Faction</th></tr></thead>
    <tbody>{flips.map((s) => <tr><td>{s.code}</td><td>{s.dem}</td><td>{signed(s.margin)}</td><td>{FACTION[s.faction].label}</td></tr>)}</tbody></table>
</Figure>
<p>{flipsUnder(3)} of the {flips.length} flips were won by less than 3 points, and {flipsUnder(5)} by less than 5. Of the {flipsBy(MB)} flipped by moderates or nominees with both flags, {flipsUnder(3, MB)} were under 3 points. The rest were won by margins the wave would have carried with almost any nominee. So even if the moderate edge in the House is as large as 3 points, it was worth roughly a handful of seats in 2026, not the majority.</p>
<p>The moderate label didn't guarantee anything either. Democrats lost {lostClose.length} House races by less than 3 points, and most of those nominees were moderate-flagged or had no flag at all.</p>
<p>The handful matters more in a normal year. In a close national environment many more seats are decided by a few points, and that is when any moderate advantage would pay off.</p>

<H id="house">{T('house')}</H>
<p>The fairer test compares nominees in similar seats. I regressed each Democrat's 2026 margin on the seat's 2024 presidential margin, incumbency and faction flags. Under the broad definition, <F f="moderate">moderate-only</F> nominees ran {Math.abs(houseModels.broadAll.est).toFixed(1)} points {ahead(houseModels.broadAll.est)} <F f="progressive">progressive-only</F> nominees across all {houseModels.broadAll.n} seats (95% interval {interval(houseModels.broadAll.lo, houseModels.broadAll.hi)}), and {Math.abs(houseModels.broadCompetitive.est).toFixed(1)} points {ahead(houseModels.broadCompetitive.est)} them in the {houseModels.broadCompetitive.n} competitive seats ({interval(houseModels.broadCompetitive.lo, houseModels.broadCompetitive.hi)}). Neither result is distinguishable from zero.</p>
<p>The strict definition gives moderates an edge of <strong>{fixed(houseModels.strictAll.est)} points</strong> (95% interval {interval(houseModels.strictAll.lo, houseModels.strictAll.hi)}). Without the seven South Texas and Central Valley seats it is {fixed(houseModels.strictNoOutliers.est)} ({interval(houseModels.strictNoOutliers.lo, houseModels.strictNoOutliers.hi)}). Controlling for the district's Hispanic and college-educated shares instead gives {fixed(houseModels.strictControls.est)}. None of these is statistically significant, partly because there are only {nStrictProg} strict progressives and {nStrictMod} strict moderates.</p>
<p>The published House analyses land in the same range:</p>
<ul>
<li>Lakshya Jain of Split Ticket, in <a href="https://www.theargumentmag.com/p/do-moderates-still-have-an-electability">The Argument</a>, models what a generic Democrat would have won in each seat. Blue Dogs ran "a little over 3 points" better than progressives, down from nearly 5 in 2018 to 2024. He concludes that moderation "may have had less of an advantage than ever before."</li>
<li>The <a href="https://cwcp.substack.com/p/ideological-endorsements-mostly-didnt">Center for Working-Class Politics</a> compared each nominee with Democrats in similar districts. Most factions came within 1 to 2 points of each other. Blue Dogs ran nearly 3 ahead, but all of that came from four candidates: Cuellar, Pulido, Jamie Ager and Dembo. Justice Democrats ran about 1.5 behind. Working-class populist candidates, claimed by both camps, did best of any group at about 6 to 7 ahead.</li>
<li>G. Elliott Morris, as reported by <a href="https://www.cnn.com/2026/11/06/politics/far-left-democrats-midterm-election">CNN</a>, measured raw swing from Harris. Progressive Caucus members averaged +12.2, New Democrats +14.1, Blue Dogs +15.4 and DSA members +16.5, the last on only seven candidates in safe seats.</li>
<li>Adam Bonica found that statewide candidates in ten key states ran only 1.3 points away from their state's House vote on average, and called the factional fight "a distraction" (<a href="https://data4democracy.substack.com/p/parties-are-electable-not-candidates">Bonica</a>).</li>
</ul>
<p>The best performers in our data were four nominees endorsed by both the Blue Dogs and Sanders or Our Revolution: Cooke in WI-3, Forstag in MT-1, Poindexter in OH-7 and Brooks in PA-7. Four races can't carry a conclusion, but it fits the Center for Working-Class Politics' finding that the populist-versus-establishment split predicted results better than left-versus-center.</p>

<H id="statewide">{T('statewide')}</H>
<p>The centrist case is strongest in the Senate. The three <F f="progressive">progressives</F> in competitive Senate races swung their states much less than the <F f="moderate">moderates</F> did. Abdul El-Sayed swung Michigan {fixed(swingOf('MI'))} points from 2024, Peggy Flanagan swung Minnesota {fixed(swingOf('MN'))}, and Troy Jackson swung Maine {fixed(swingOf('ME'))}. {Cap(w(senateCompetitive.moderate.length))} moderates in competitive races averaged {modCompetitiveMean.toFixed(1)}. Jonathan Chait made a similar point, about five Sanders-backed candidates rather than these three:</p>
<Quote who="Jonathan Chait" source="The Atlantic (archived)" href="https://archive.ph/20261112201741/https://www.theatlantic.com/ideas/2026/11/moderates-midterms-success-progressives/689371/" when="November 11">The five left-wing candidates backed by Sanders accounted for the four smallest swings in contested races.</Quote>
<p>Much of that gap comes from geography. Red states swung harder no matter who ran. Across the {races.length} races, leaving out Vermont's governor race against the popular Republican incumbent Phil Scott, each point of Trump's 2024 margin added about {Math.abs(swingSlope.slope).toFixed(2)} points of Democratic swing ({Math.abs(swingSlope.withAll).toFixed(2)} with Vermont included), and the moderates in that comparison ran in red states while the progressives ran in purple and blue ones.</p>
<Figure id="fig-scatter" legend={['moderate', 'progressive', 'mixed-unclear']} hint="Press to highlight"
  caption={`${races.length} Senate and governor races with a Democrat against a Republican. The dashed line is the average relationship, fitted without Vermont's governor race: each point of 2024 Trump margin goes with about ${Math.abs(swingSlope.slope).toFixed(2)} more points of Democratic swing. Races off the bottom of the scale are drawn at the edge and labelled.`}>
  <StateScatter />
  <table slot="table"><thead><tr><th>State</th><th>Office</th><th>Democrat</th><th>Faction</th><th>2024 margin</th><th>2026 margin</th><th>Swing</th></tr></thead>
    <tbody>{[...races].sort((a, b) => b.swing - a.swing).map((r) => <tr><td>{r.st}</td><td>{r.office}</td><td>{r.dem}</td><td>{FACTION[r.faction].label}</td><td>{signed(r.pres24)}</td><td>{signed(r.margin)}</td><td>{signed(r.swing)}</td></tr>)}</tbody></table>
</Figure>
<p>Opponents mattered too. Talarico faced Ken Paxton, whom about two thirds of Texas voters said lacked the character to serve. Annie Andrews faced Darline Graham, appointed to the seat after Lindsey Graham's death (<a href="https://www.clickondetroit.com/news/politics/2026/11/04/how-trump-and-republicans-lost-the-2026-midterm-elections-according-to-the-ap-voter-poll/">AP Voter Poll</a>). Adam Hamilton faced Roger Marshall, whose approval fell to 26 percent in the Docking Institute's Kansas Speaks survey, down from 34 percent in 2024; his former practice had been reported to have sued more than 700 patients over medical debt (<a href="https://mediaite.com/politics/kansas-sen-roger-marshall-gets-wrecked-by-poll-respondents-over-suing-his-patients-total-scumbag-fake-kansan">Mediaite</a>). In our statewide model, facing a Republican who had held elected office cost about {Math.abs(statewideModel.officeholder.est).toFixed(0)} points of swing, roughly as much as being progressive.</p>

<H id="same-ballot" level={3}>{T('same-ballot')}</H>
<p>A closer comparison holds the state, the day and the national mood fixed, though not incumbency. In {w(pairs.length)} states, one statewide Democrat was <F f="progressive">progressive</F> and the other <F f="moderate">moderate</F>.</p>
<Figure id="fig-pairs" legend={['moderate', 'progressive']} hint="Press to highlight"
  caption="States where one statewide Democrat was progressive and the other moderate. Margins are Democratic minus Republican share.">
  <PairsChart />
  <table slot="table"><thead><tr><th>State</th><th>Progressive</th><th>Margin</th><th>Moderate</th><th>Margin</th><th>Progressive minus moderate</th></tr></thead>
    <tbody>{pairs.map((p) => <tr><td>{p.prog.state}</td><td>{p.prog.dem} ({p.prog.office})</td><td>{signed(p.prog.margin)}</td><td>{p.mod.dem} ({p.mod.office})</td><td>{signed(p.mod.margin)}</td><td>{signed(p.diff)}</td></tr>)}</tbody></table>
</Figure>
<p>In the three competitive states the progressive ran behind. El-Sayed trailed Jocelyn Benson by {Math.abs(MI.diff).toFixed(1)} points of margin in Michigan, and Flanagan trailed Amy Klobuchar by {Math.abs(MN.diff).toFixed(1)} in Minnesota. Jackson trailed Hannah Pingree by {Math.abs(ME.diff).toFixed(1)} in Maine, but an independent took 8 percent in the governor's race, so on vote share the three gaps are {Math.abs(MI.shareDiff).toFixed(1)}, {Math.abs(MN.shareDiff).toFixed(1)} and {Math.abs(ME.shareDiff).toFixed(1)} points. In safe blue states the pattern reverses: Jeff Merkley ran {OR.diff.toFixed(1)} points ahead of Tina Kotek in Oregon and Ed Markey {MA.diff.toFixed(1)} ahead of Maura Healey in Massachusetts. Across all {w(pairs.length)} pairs the progressive averaged {signed(-pairSummary.mean)} points against the moderate (95% interval {interval(-pairSummary.hi, -pairSummary.lo)}), which is noise. But the three pairs where the progressive ran ahead, Illinois, Massachusetts and Oregon, rest on moderate labels I hold with low confidence (Pritzker, Healey and Kotek). Leaving those out, the other {w(pairSummaryConfident.n)} pairs put the moderate {fixed(pairSummaryConfident.mean)} points ahead (95% interval {interval(pairSummaryConfident.lo, pairSummaryConfident.hi)}), still too few to be sure. Two moderates on Iowa's ballot, Josh Turek and Rob Sand, were {iaPair.toFixed(1)} points apart.</p>
<p>A regression across the {statewideModel.n} races with exit-poll and opponent data, controlling for the 2024 margin, incumbency, office, the white share of the electorate and opponent quality, puts progressives {statewideModel.prog.est.toFixed(1)} points behind all other Democrats (95% interval {fixed(statewideModel.prog.lo)} to {fixed(statewideModel.prog.hi)}). Those others include {statewideModel.nMixed} nominees I code as mixed or unclear; compared with the {statewideModel.nMod} moderates alone, the gap is {fixed(statewideModel.vsModerate.est)} ({interval(statewideModel.vsModerate.lo, statewideModel.vsModerate.hi)}). It rests on {w(statewideModel.nProg)} progressive nominees, only three of them in competitive races, and it is fragile. Leaving out any one progressive moves the estimate between {fixed(statewideModel.dropOne.estMin)} and {fixed(statewideModel.dropOne.estMax)}, and leaving out {orList(statewideModel.dropOne.zeroIn.map(stateName))} pulls the bottom of the interval to about zero or below. Putting the pairs and the regression together, my best reading is that progressives ran <strong>about 1 to 6 points</strong> of margin behind comparable Democrats statewide, on thin evidence.</p>

<H id="michigan" level={3}>{T('michigan')}</H>
<p>El-Sayed ran behind Benson across most of the state, though not everywhere: he beat her margin in Dearborn and came within about a point of her in Detroit and Washtenaw County (<a href="https://bridgemi.com/?p=83223">Bridge Michigan</a>). That suggests a broad penalty rather than one group defecting. Several things fed it.</p>
<ul>
<li>Outside groups spent about $134 million opposing him in the general election, around three times the $42 million spent against Roy Cooper in North Carolina, a state of similar size (<a href="https://votelog.org/investigations/michigan-senate-general-money">VoteLog Michigan</a>, <a href="https://votelog.org/investigations/north-carolina-senate-general-money">VoteLog North Carolina</a>).</li>
<li>A September Washington Post and Schar School poll found 45 percent of likely Michigan voters would not consider a Muslim for president. Rogers led that group 75 to 18, and "El-Sayed's support among that group is six percentage points lower than Benson's" (<a href="https://archive.ph/20261030013825/https://www.washingtonpost.com/politics/2026/09/17/michigan-senate-race-poll-finds-abdul-el-sayed-has-narrow-edge-over-mike-rogers/">Washington Post, archived</a>). It is a subgroup of an 803-person poll whose margin of error is 3.9 points overall and larger for subgroups, so it can't size the effect precisely, but a gap of a few points of support in a group that large would account for a real part of his {fixed(Math.abs(MI.shareDiff))}-point vote-share gap with Benson.</li>
<li>The same poll found 48 percent calling El-Sayed "too liberal" for them, against 43 percent calling Rogers "too conservative."</li>
</ul>
<Quote who="Justin Gest, George Mason University's Schar School" source="in the Post's write-up of the poll" href="https://archive.ph/20261030013825/https://www.washingtonpost.com/politics/2026/09/17/michigan-senate-race-poll-finds-abdul-el-sayed-has-narrow-edge-over-mike-rogers/" when="September 17">It is tempting to attribute El-Sayed's lackluster polling exclusively to Islamophobia, but his socialist endorsements and policy positions are certainly not helping him either.</Quote>
<p>Religious bias and ideology overlap in Michigan and can't be separated with the data available. Minnesota is cleaner. Flanagan faced only about $2.6 million in outside opposition (<a href="https://votelog.org/investigations/minnesota-senate-general-money">VoteLog Minnesota</a>) and a first-time candidate, and still ran about {Math.abs(MN.shareDiff).toFixed(0)} points of vote share behind Klobuchar, whose long statewide record explains part of that. Maine is the weakest evidence either way. Jackson became the nominee in late July after Graham Platner withdrew, and he beat Susan Collins, who had won five straight elections. Chait's reply, that Collins is formidable because "she has built a reputation as a moderate," is fair as far as it goes. But Collins was hard for any Democrat to beat, and Jackson beat her.</p>

<H id="estimates">{T('estimates')}</H>
<p>The chart collects every estimate of the moderate advantage from this page and from published work, before and after 2026.</p>
<Figure id="fig-forest" caption="Filled dots are this page's estimates, hollow dots are published ones. Lines show a 95% interval or a published range; a dot without a line had no interval published, so it is less precise than it looks. Positive numbers favour moderates. The rows measure different things (regressions, same-ballot gaps, published models over different years and comparison groups), so read them as a range of answers, not one estimate.">
  <ForestChart />
  <table slot="table"><thead><tr><th>Estimate</th><th>Moderate advantage</th><th>Range or 95% interval</th><th>Source</th></tr></thead>
    <tbody>{forest.flatMap((gr) => gr.rows).map((r) => <tr><td>{r.label}</td><td>{signed(r.est)}</td><td>{r.lo !== null && r.hi !== null ? interval(r.lo, r.hi) : 'not published'}</td><td>{r.own ? 'this page' : 'published'}</td></tr>)}</tbody></table>
</Figure>
<p>The pattern is consistent. Older studies found a large moderation premium. Andrew Hall's study of close primaries found that nominating the more extreme candidate cost a party 9 to 13 points of vote share (<a href="https://cambridge.org/core/services/aop-cambridge-core/content/view/ECAC69648AE0DF91D93103E18342B9D2/S0003055414000641a.pdf/what-happens-when-extremists-win-primaries.pdf">Hall 2015</a>). Hall and Daniel Thompson later traced most of that to the other party's voters turning out against the extremist (<a href="https://www.cambridge.org/core/product/366A518712BE9BCC1CB035BF53095D65">Hall and Thompson 2018</a>). Those studies measure vote share over 2006 to 2014, so they aren't on the chart's scale. Recent estimates are far smaller. Split Ticket's Lakshya Jain put the Blue Dog edge at nearly 5 points for 2018 to 2024 (<a href="https://www.theargumentmag.com/p/do-moderates-still-have-an-electability">The Argument</a>), Morris at 1 to 1.5 points for 2024, and Bonica and Grumbach at about zero (<a href="https://data4democracy.substack.com/p/do-moderates-do-better">Bonica and Grumbach</a>). The 2026 House numbers sit at the low end of that range. The statewide numbers sit higher.</p>
<p>Even Chait frames the dispute as being "over how much of an advantage moderates have in winning elections, not which posture is more advantageous." On the evidence here, the answer is a few points, smaller than it used to be, and larger in statewide races than in House races.</p>

<H id="hasan">{T('hasan')}</H>
<p>Hasan's video gives eight reasons the centrist story is wrong: opponent quality, race, racism against El-Sayed, money, media coverage, local factors, the "erasure" of progressive wins in red seats, and the question of who counts as a moderate. Several hold as far as they go. Raw margin comparisons between states mislead, opponent quality and money mattered, and progressives did win Republican-held seats such as CA-22 and MI-7. But the main centrist analyses he answers already measure swing from each state's own baseline, so the points aimed at raw margins mostly miss them. His conclusion that the claim is baseless goes too far. Statewide, the thin evidence favours a moderate edge of a few points: Benson and Klobuchar faced the same money, media and state mood on the same ballots as El-Sayed and Flanagan, and still ran ahead. In the House, no clear gap shows up either way.</p>
<p>The centrist claim overreaches too. Moderates did win most of the flips, but they won them on a wave that lifted everyone. Any edge they had decided at most a handful of seats this year. The fair summary is that moderates may have a modest, shrinking advantage, clearer statewide than in the House. Such an edge mattered little in 2026, and it would matter more in a close year. Brookings's post-election analysis put it more cautiously still:</p>
<Quote who="Elaine Kamarck and William Galston" source="Brookings" href="https://www.brookings.edu/articles/how-democrats-won-big-and-why-2028-remains-an-open-question/" when="November 6">The midterm results do not conclusively show which kind of Democrat would be more electable at the national level in 2028.</Quote>

<p>Each of the claims in Hasan's video, and in a second interview he gave the same day, is checked with the clip on <a href="hasan/">a separate page: Mehdi Hasan's claims, checked</a>.</p>

<H id="primaries">{T('primaries')}</H>
<p>So far the page has asked how nominees did once they were on the ballot. The rest asks how they got there, and who paid for them. Start with the obvious question: if the gap is only a few points, why doesn't the party run progressives everywhere? Several reasons stack up.</p>
<ul>
<li><strong>A few points decides close seats.</strong> Primary voters and party groups in swing districts know a marginal seat can turn on 2 or 3 points, and many vote for the candidate they think is safer.</li>
<li><strong>Swing-seat primary electorates are less left.</strong> Democratic primary voters outside safe blue cities tend to be older and more moderate. That alone favours moderate candidates there, before any money is spent.</li>
<li><strong>Money and institutions back moderates in swing seats.</strong> The party's campaign committees and allied groups usually pick a candidate in target seats, and outside money follows. In Michigan's Senate primary, outside groups spent about $54 million supporting El-Sayed's rival Haley Stevens (<a href="https://www.pbs.org/newshour/politics/democrat-abdul-el-sayed-wins-election-to-u-s-senate-from-michigan">PBS</a>).</li>
<li><strong>Progressive groups pick winnable primaries.</strong> Justice Democrats, DSA and similar groups mostly play in safe blue seats where a progressive can win the nomination. Midway through the 2018 primaries, FiveThirtyEight found Justice Democrats and Our Revolution endorsees had won 32 percent of their primaries, against 95 percent for the party committees' picks (<a href="https://web.archive.org/web/2018/https://fivethirtyeight.com/features/the-establishment-is-beating-the-progressive-wing-in-democratic-primaries-so-far/">FiveThirtyEight</a>).</li>
</ul>
<p>When progressives did win swing-seat House primaries this year, they mostly ran well. Villegas won CA-22 by about {Math.round(seatByCode('CA-22').margin)} points in a seat Trump carried, and Lawrence won MI-7. Matt Dunlap trails in the open ME-2 by {Math.abs(seatByCode('ME-02').margin).toFixed(1)} points with the race uncalled, Justin Pearson lost a redrawn TN-9 by {Math.abs(seatByCode('TN-09').margin).toFixed(1)} and Tom Perriello lost VA-5 by {Math.abs(seatByCode('VA-05').margin).toFixed(1)}. Measured against 2024, these five averaged {signed(swingPrimaryMean)}, against {signed(houseMeanAll)} for all House Democrats. The penalty shows up statewide instead: El-Sayed, Flanagan and Jackson won their Senate races while trailing comparable Democrats.</p>
<p>The economic message also converged. Eric Blanc found the word "billionaire" on 25 of 32 Democratic Senate campaign websites in 2026, up from 6 of 32 in 2024 (<a href="https://www.thenation.com/article/politics/midterms-analysis-billionaires/">The Nation</a>). Moderates and progressives both ran on anti-elite economics. Where they still differed was on Medicare for All, ICE, Israel and trans issues.</p>

<H id="leaders">{T('leaders')}</H>
<p>Much of the anger about primaries has landed on the two party leaders: Chuck Schumer in the Senate and Hakeem Jeffries in the House. It helps to keep three actors apart. There is the leader himself (his statements, endorsements and his own PACs: Schumer's IMPACT, Jeffries' JEFF PAC and campaign committee). There is the party committee (the DSCC, chaired this cycle by Kirsten Gillibrand, and the DCCC). And there is the super PAC aligned with each leader (Senate Majority PAC with WinSenate and its other affiliates, and House Majority PAC). This section is about the primaries; the general-election money, mostly from the super PACs, comes in the <a href="#money">next section</a>.</p>
<p>The short version: both leaders took the moderate or incumbent side in contested primaries, and nearly every side they picked lost. But their super PACs spent nothing in those primaries. The heavy primary spending against progressives came from other groups, and I found no link from any of them to either leader. After the primaries, both backed the progressive winners.</p>
<p class="asof"><strong>Last checked November 16, 2026.</strong> Unlike the charts, this section does not update with the daily data. Statements, endorsements and the leadership races described here may have moved on: the House caucus votes the week of November 16, and the Senate vote is expected December 1 or in January. The leaders' own PAC filings run only to mid-summer until the post-election reports due December 3.</p>

<H id="schumer" level={3}>{T('schumer')}</H>
<ul>
<li><strong>Michigan.</strong> Schumer said of Haley Stevens on June 11, "I think she has the best chance to win" (<a href="https://punchbowl.news/article/campaigns/schumer-stevens/">Punchbowl</a>). His PAC gave her $10,000 on July 7, and the DSCC logged a $4,000 coordinated expenditure for her on May 6. That is the whole Schumer-side money trail for Stevens. The DSCC's filings also show a $100,000 coordinated media payment for El-Sayed dated August 3, the day before the primary. The millions behind Stevens came from elsewhere: A Stronger Michigan ($17.2 million, funded through the dark-money group Center Forward), AIPAC's United Democracy Project ($10.5 million for her and $20.1 million against El-Sayed) and Unite to Win ($6.8 million). Senate Majority PAC, WinSenate and the DSCC made no independent expenditures in the primary. After El-Sayed won, Schumer and Gillibrand put out a joint statement the next day ("We look forward to working with Abdul"), and the DSCC sent its maximum $62,000 the same day (<a href="https://www.axios.com/2026/08/06/schumer-senate-midterms-progressives">Axios</a>).</li>
<li><strong>Maine.</strong> Schumer spent more than a year recruiting Gov. Janet Mills and endorsed her, but no leadership committee or allied PAC spent for her before she quit in April (<a href="https://washingtonsun.com/2026-election/janet-mills-exit-maine-schumer-platner">NOTUS</a>). He then backed Graham Platner after his primary and Troy Jackson after the convention, and the network went on to spend {millions(m('ME').partyTotal)} for Jackson in the general election.</li>
<li><strong>Minnesota.</strong> Reporting called Angie Craig the leadership's preference, but I found no Schumer endorsement or money for her; PolitiFact also found that "Schumer did not endorse either candidate" (<a href="https://politifact.com/factchecks/2026/nov/09/jon-stewart/chuck-schumer-senate-candidate-recruitment/">PolitiFact</a>). Her named endorsers were Jeffries and Nancy Pelosi. The primary money for Craig came from North Star Dawn PAC ($8.9 million for her and $7.3 million against Peggy Flanagan) and Unite to Win ($1.0 million against Flanagan). I found no Schumer statement after Flanagan won.</li>
<li><strong>Elsewhere.</strong> His PAC gave the maximum to Alex Vindman (Florida) and Josh Turek (Iowa) before their primaries; Vindman lost to Angie Nixon. He stayed out of Illinois, where the crypto PAC Fairshake spent $10.2 million against Juliana Stratton, and Texas. The DSCC also gave its $62,000 maximum to progressive incumbent Ed Markey before his primary.</li>
</ul>

<H id="schumer-defense" level={3}>{T('schumer-defense')}</H>
<p>Schumer's main public defense came at the weekly leadership press conference on November 10, two days before Van Hollen declared (<a href="https://archive.today/jTCuK">official transcript, archived</a>; <a href="https://www.youtube.com/watch?v=utxxHmK_IOI">video</a>). Asked whether they backed him, the senators beside him answered for him, and Kirsten Gillibrand, who chairs the DSCC, spoke for about three and a half minutes. Schumer himself said little beyond "I'm confident I will be elected Majority Leader" and "great unity in our caucus," and he did not take up the charge about primaries. His fullest answer on recruiting came in a November 6 interview on The New York Times' The Daily. Asked whether he regretted backing Mills and Stevens, he said: "No, I feel very good about it" (<a href="https://www.democrats.senate.gov/news/press-releases/transcript-leader-schumer-joins-the-new-york-times-the-daily-to-discuss-democrats-commitment-to-addressing-republicans-costs-chaos-and-corruption-after-major-midterm-victory">transcript</a>). After Van Hollen declared, Schumer posted: "55 seats and counting… I have the votes" (<a href="https://x.com/SenSchumer/status/2121061686786314623">X</a>).</p>
<div class="table-wrap claims-wrap"><table class="claims">
<thead><tr><th>Claim</th><th>Who, where</th><th>What the record shows</th></tr></thead>
<tbody>
<tr><td>"The single largest landslide for Senate Democrats since the 50s"</td><td>Schumer, Nov 10</td><td><strong>Mostly true.</strong> As of November 14, Democrats had gone from 47 to 55 seats, +8 so far and +9 if Alaska is called for them. +8 ties 1986 and 2008 as the largest Democratic Senate gain since 1958; +9 would pass them.</td></tr>
<tr><td>"Great unity in our caucus"</td><td>Schumer, Nov 10</td><td><strong>Misleading.</strong> He said it hours after Sanders said he would not back him and Slotkin withheld her support (<a href="https://rollcall.com/2026/11/10/rift-grows-among-senate-democrats-over-who-will-lead-in-majority/">Roll Call</a>).</td></tr>
<tr><td>"$60 million… to help Abdul"</td><td>Schumer, The Daily, Nov 6</td><td><strong>True.</strong> About $58 to $62 million: {millions(m('MI').partyTotal)} to {millions(miPartyAll)} of party-network independent spending, depending on how much of Lower Costs Now counts as Schumer's network (see <a href="#money">the money section</a>), plus about $6.9 million of DSCC coordinated spending.</td></tr>
<tr><td>Schumer "raised another $600 million"</td><td>Gillibrand, Nov 10</td><td><strong>Substance true, figure unsupported.</strong> His own side says $550 to $553 million (<a href="https://www.dscc.org/article/a-generational-remake-of-the-senate-map-how-democrats-top-tier-senate-recruits-and-550-million-push-delivered-a-blowout-midterm-victory/">DSCC</a>). FEC filings as of November 14 show about $475 million in the 11 key races, a figure that will grow as post-election reports come in; the rest is plausibly issue ads that the FEC doesn't capture.</td></tr>
<tr><td>Democrats were "so outspent"</td><td>Gillibrand, Nov 10</td><td><strong>Mostly true for outside money.</strong> About $1.1 billion against Democrats against $708 million for them in the 11 races, though Democratic candidates far outraised their opponents (Ossoff $116 million to Mike Collins's $11 million).</td></tr>
<tr><td>"Elon Musk dumping in his billions"</td><td>Gillibrand, Nov 10</td><td><strong>False as stated.</strong> Estimates run from about $445 million (<a href="https://www.citizen.org/article/millionaires-and-billionaires-fuel-2026-super-pac-spending/">Public Citizen</a>) to about $500 million.</td></tr>
<tr><td>He recruited Sherrod Brown and Roy Cooper early</td><td>Gillibrand, Nov 10</td><td><strong>True.</strong> Both entered in summer 2025, more than a year before the election, and Axios reported Schumer's "two trips to Ohio this summer" to court Brown (<a href="https://www.axios.com/2025/08/04/sherrod-brown-ohio-senate-race-husted">Axios</a>). Both won.</td></tr>
<tr><td>Resources "over a year ago to register 100,000 new voters" in Mississippi</td><td>Gillibrand, Nov 10</td><td><strong>Unsupported.</strong> I found no DSCC voter-registration program in Mississippi. The DSCC left the state out of its $40 million July 2026 program, and Rep. Bennie Thompson complained publicly (<a href="https://mississippitoday.org/2026/09/21/bennie-thompson-colom-democrats-dscc/">Mississippi Today</a>). The DNC did announce a "six-figure investment" in the Mississippi Democratic Party in October 2025, for voter contact, advertising and party building, with no mention of voter registration (<a href="https://democrats.org/?p=1056342">DNC</a>). It may be what she had in mind. Party-aligned spending in the 2026 race totaled about $2.2 million.</td></tr>
<tr><td>"Most of our candidates are under the age of 45"</td><td>Gillibrand, Nov 10</td><td><strong>False for the Senate class.</strong> The incoming Democratic senators average about 53. Only Talarico, El-Sayed and Colom are under 45.</td></tr>
<tr><td>Aligned groups spent "$553 million on 11 Senate races"</td><td>Source close to Schumer, Nov 13 (<a href="https://www.ms.now/news/van-hollen-schumer-senate-democratic-leader-majority">MS NOW</a>)</td><td><strong>Mostly true,</strong> see the $600 million row. It answers the general-election charge, not the primary one.</td></tr>
<tr><td>"I have the votes"</td><td>Schumer, X, Nov 12</td><td><strong>Unverifiable.</strong> The vote is a secret ballot. 14 to 16 senators back him publicly; he needs about 28.</td></tr>
</tbody></table></div>
<p>The story of Schumer travelling three times to recruit a candidate is his own. On The Daily he said:</p>
<Quote who="Chuck Schumer" source="The Daily" href="https://www.democrats.senate.gov/news/press-releases/transcript-leader-schumer-joins-the-new-york-times-the-daily-to-discuss-democrats-commitment-to-addressing-republicans-costs-chaos-and-corruption-after-major-midterm-victory" when="November 6">I flew out to Columbus three times to see Sherrod and Connie.</Quote>
<p>On the third visit, he said, he told Sherrod Brown he wouldn't enjoy his retirement if Democrats lost the Senate by one seat. Reporting at the time confirms two trips in summer 2025 (<a href="https://www.axios.com/2025/08/04/sherrod-brown-ohio-senate-race-husted">Axios</a>: "two trips to Ohio this summer"); the third rests on Schumer's word. PolitiFact wrote that he flew there twice, but the audio says three (<a href="https://politifact.com/factchecks/2026/nov/09/jon-stewart/chuck-schumer-senate-candidate-recruitment/">PolitiFact</a>). Brown ran and won Ohio by about 5 points, with the most party-aligned money of any race. So the story is mostly true, and it shows what Schumer is good at: getting well-known names into races early. Brown faced no serious primary, though, so it says nothing about the open primaries Van Hollen is criticizing.</p>
<p>Taken together, the defense answers a charge few critics made, that Schumer failed to recruit or fund Senate candidates, and mostly with true numbers. It doesn't answer the one they did make, that he took sides in open primaries against candidates who then won.</p>

<H id="jeffries" level={3}>{T('jeffries')}</H>
<ul>
<li><strong>Swing seats.</strong> Jeffries' committees gave $14,000 each in May ($9,000 after the general-election portions were refunded in July) to the DCCC's picks in CA-22 (Jasmeet Bains) and ME-2 (Joe Baldacci). The DCCC put Bains on Red to Blue a month before the primary and ran a $135,000 joint ad buy with her (<a href="https://axios.com/2026/06/09/democrats-house-primary-california-villegas-bains">Axios</a>). Both lost to progressives. House Majority PAC and Team Blue, the incumbent-protection PAC Jeffries co-founded, spent nothing in these primaries.</li>
<li><strong>Safe New York seats.</strong> He endorsed incumbents Dan Goldman (NY-10) and Adriano Espaillat (NY-13), and both lost to Mamdani-backed challengers on June 23. His own money to each was about $7,000; the big pro-Espaillat spending came from Hispanic Caucus-linked groups and a PAC called Progressive Unity Fund. He stayed neutral in NY-7, which DSA's Claire Valdez won.</li>
<li><strong>Other groups.</strong> DMFI ran a $500,000 TV buy against Villegas, and the Rolling Sea Action Fund, a group the American Prospect calls affiliated with the Congressional Black Caucus, spent about $1 million against Lawrence (<a href="https://prospect.org/2026/07/17/cbc-condemns-will-lawrence-local-black-leaders-back-him-up-michigan-congress/">Prospect</a>). I found no source tying either to Jeffries.</li>
<li><strong>After the primaries.</strong> He congratulated Villegas, Dunlap, Lawrence and Pearson within about a day of each win. The DCCC added Villegas to Red to Blue the day he won, but Dunlap waited two months, Lawrence until September 15 (CNN reported the DCCC held back "partly out of deference to Congressional Black Caucus leaders") and Pearson until October 5, after Ayanna Pressley urged the DCCC to help him (<a href="https://www.axios.com/2026/10/01/democrats-black-candidates-house-races">Axios</a>).</li>
</ul>

<H id="leader-claims" level={3}>{T('leader-claims')}</H>
<div class="table-wrap claims-wrap"><table class="claims">
<thead><tr><th>Accusation</th><th>Made by</th><th>What the record shows</th></tr></thead>
<tbody>
<tr><td>Schumer took sides in open primaries: "we shouldn't have a Democratic leader who is getting involved in picking sides in open Democratic primaries"</td><td>Sen. Chris Van Hollen, Nov 12 (<a href="https://www.cbsnews.com/news/chris-van-hollen-challenge-chuck-schumer-senate-majority-leader-democrat/">CBS News</a>)</td><td><strong>True.</strong> He recruited and endorsed Mills, publicly backed Stevens with $10,000, and maxed out to Vindman and Turek.</td></tr>
<tr><td>"Two senators… wouldn't be there if the current majority leader had his way"</td><td>Van Hollen, Nov 12</td><td><strong>Partly true.</strong> Solid for El-Sayed over Stevens. For Flanagan over Craig, Schumer's preference is reported, not on record.</td></tr>
<tr><td>Schumer put millions, or "$10 million", behind Stevens in the primary</td><td>Viral posts on X</td><td><strong>Wrong.</strong> His super PAC network and the DSCC made no independent expenditures in the Michigan primary. The millions came from A Stronger Michigan, AIPAC's super PAC and others.</td></tr>
<tr><td>Schumer steered donors to Stevens and Craig</td><td>Anonymous senators to The Hill, May 1</td><td><strong>Unsupported.</strong> No figures given, and donor steering leaves no public filing, so it can't be confirmed or ruled out.</td></tr>
<tr><td>Schumer's side gave Nixon and Jamie Davis nothing</td><td>Robert Kuttner, <a href="https://prospect.org/2026/11/13/van-hollens-challenge-to-chuck-schumer/">American Prospect</a>, Nov 13</td><td><strong>Mostly true.</strong> No network or DSCC independent spending for either. Punchbowl reported in October that Schumer gave to Nixon through his PAC, without an amount; that PAC's filings so far run only to late July, so it can't be checked yet. The $5,000 on file for her came from Gillibrand's PAC.</td></tr>
<tr><td>Schumer "was slow to rally behind the new nominee, Troy Jackson"</td><td>Kuttner, Nov 13</td><td><strong>Partly wrong.</strong> The network spent {millions(m('ME').partyTotal)} for him, one of the highest rates per adult of any race. Its first ad came 37 days after his convention. Kuttner's complaint was about speed and about the consultants sent, which filings can't measure.</td></tr>
<tr><td>The DCCC "tried to tip the scales" in CA-22</td><td>Rep. Adelita Grijalva, Jun 9</td><td><strong>True.</strong> Red to Blue a month out and a $135,000 joint ad buy for Bains.</td></tr>
<tr><td>Jeffries "supported a lot of the folks who my endorsees beat"</td><td>Chris Rabb, Jul 8 (<a href="https://www.axios.com/2026/07/08/democrats-jeffries-primaries-speaker-vote-dsa">Axios</a>)</td><td><strong>True.</strong> Goldman, Espaillat, Bains and Baldacci.</td></tr>
<tr><td>The DCCC kept Lawrence off Red to Blue partly in deference to the CBC</td><td>CNN, Sep 7, anonymous sources</td><td><strong>True as reported.</strong> He was added Sep 15, and House Majority PAC then spent heavily for him.</td></tr>
<tr><td>Jeffries' side abandoned progressive nominees in November</td><td>Common in post-election commentary</td><td><strong>Mostly wrong for Toss-up and Lean seats.</strong> Three of the four progressive challengers there got more per vote than the moderate medians; the fourth, Perriello in VA-5, got nothing. True for reach seats such as Pearson's, where moderates were skipped too.</td></tr>
</tbody></table></div>

<H id="leadership-fights" level={3}>{T('leadership-fights')}</H>
<p>As of November 16, the primary record is driving a challenge to Schumer and only pressure on Jeffries.</p>
<ul>
<li><strong>Schumer.</strong> Chris Van Hollen declared for Senate Democratic leader on November 12. A caucus vote is reported for December 1 (<a href="https://time.com/article/2026/11/13/chris-van-hollen-senate-majority-leader-chuck-schumer-progressive-democrats/">TIME</a>), though one report says January. Bernie Sanders, Jeff Merkley and the two senators-elect who beat Schumer's favorites, El-Sayed and Flanagan, back Van Hollen (<a href="https://newrepublic.com/post/217991/full-list-senators-back-chris-van-hollen-leader">TNR</a>, <a href="https://www.ms.now/news/van-hollen-schumer-senate-democratic-leader-majority">MS NOW</a>). Jackson told Schumer he would support someone else, despite the {millions(m('ME').partyTotal)} the network spent for him. Juliana Stratton, who pledged in her primary not to back Schumer, says she will vote against him without endorsing Van Hollen; Sherrod Brown backs Schumer. Public counts on November 13 had about 14 to 16 senators for Schumer, 10 or 11 leaning to Van Hollen and the rest undeclared, with 28 votes needed, or 29 if Alaska goes Democratic (<a href="https://whipcount.dropsitenews.com/">Drop Site whip count</a>). Schumer says "I have the votes." His allies' case is Angus King's: "Why would you fire the manager when you just won the World Series?" (<a href="https://prospect.org/2026/11/13/van-hollens-challenge-to-chuck-schumer/">American Prospect</a>).</li>
<li><strong>Jeffries.</strong> No one is running against him in the House caucus vote the week of November 16. Alexandria Ocasio-Cortez said "There is one candidate in this race, Hakeem Jeffries." Several incoming members are withholding their votes, but their stated demands are about corporate PAC money, Citizens United and policy, not campaign funding (<a href="https://axios.com/2026/11/11/house-democrats-jeffries-speaker-vote-freshmen">Axios</a>).</li>
</ul>
<p>The critics have the right charge and the wrong mechanism. Both leaders picked sides early and mostly lost, which is documented. But the money that actually fought progressives in primaries came from AIPAC's super PAC, the crypto industry, dark-money groups and caucus-aligned PACs, not from the leaders' own super PACs. A leader who stayed neutral in open primaries would not, by itself, have removed that money. Filings for the leaders' own PACs stop in mid-summer, so their later gifts can't be checked until the December reports.</p>

<H id="hasan-schumer" level={3}>{T('hasan-schumer')}</H>
<p>Mehdi Hasan made the case against Schumer on Fast Politics with Molly Jong-Fast, recorded on November 13, the day Van Hollen spoke to a Democratic conference in Denver. He is right on the record that matters most here: Schumer backed Mills and Stevens, Scott Colom rejects the credit Schumer claimed for recruiting him, and Jackson beat a senator who had beaten five Democrats. His numbers run ahead of the evidence: Democrats have 55 seats and eight flips, not 56 and seven, and about half of the incoming senators, not most, ran against Schumer. Angie Nixon says more money in September would have won her race, but she declined to put the blame on Schumer. Every claim from that interview and from his Zeteo video is checked, with the clips, on <a href="hasan/">a separate page</a>.</p>

<H id="money">{T('money')}</H>
<p>Once the primaries were over, the complaint changed. Some progressives say the party establishment left their nominees to fend for themselves. Others answer that the establishment spent heavily on progressives while progressive groups spent little. The two sides met over Michigan in October:</p>
<div class="pq-pair">
<Quote who="Rep. Ayanna Pressley" source="at a rally for El-Sayed, as quoted by the NYT's Shane Goldmacher" when="October">The DSCC should take note because it is shameful that we are not seeing an equitable investment in progressive and diverse candidates like Abdul El-Sayed, like Angie Nixon, like Scott Colom.</Quote>
<Quote who="Neera Tanden" source="replying on X" href="https://x.com/neeratanden/status/2111221856501961005" when="October 16">Schumer has spent $35 million. How much has Sanders spent out of his $22 million warchest in Michigan?</Quote>
</div>
<p>Bill Scher's Washington Monthly piece was titled <a href="https://washingtonmonthly.com/2026/10/30/democrats-progressive-candidates-2026/">"Hey, Bernie, the Democratic Establishment Is Spending Big on Progressive Insurgents."</a></p>
<p>Federal filings can settle most of this. I count as <em>party money</em> what the party committees and their allied super PACs spent: the DSCC and DCCC, and the Senate Majority PAC and House Majority PAC networks, including state-named affiliates such as WinSenate in Michigan. Lower Costs Now, a joint vehicle that got $30 million of its $50 million from Senate Majority PAC and the rest from Future Forward, counts at {Math.round(LCN_PARTY_SHARE * 100)} percent. The figures below are independent expenditures for the general election from the FEC's bulk files, plus DCCC coordinated spending where noted. To compare states of very different size, Senate money is divided by each state's adult population and House money by votes cast. Two gaps remain until the post-election reports due December 3: campaign receipts and party coordinated spending after mid-October, including roughly $20 million of late DCCC spending, and issue ads, which never appear in FEC data.</p>

<H id="senate-money" level={3}>{T('senate-money')}</H>
<Figure id="fig-senate-money" legend={['moderate', 'progressive', 'mixed-unclear']} hint="Press to highlight"
  caption="Contested Senate races, grouped by the Cook Political Report's final rating. The coloured mark is spending for the Democrat by the Senate Majority PAC network (with Lower Costs Now at 60 percent, Senate Majority PAC's share of its funding) and the DSCC's independent spending. The grey tick is all outside spending against the Democrat. Both are general-election independent expenditures per adult resident (2024 voting-age population). The right column, party matched, is party money for the Democrat divided by all outside money against them: how much of the attack spending the party itself answered. It leaves out other pro-Democratic groups, the candidate's own fundraising and party coordinated spending.">
  <span slot="legend" class="lg static"><svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true"><line x1="7" x2="7" y1="0" y2="16" class="against" /></svg>Spent against the Democrat</span>
  <SenateMoneyChart />
  <table slot="table"><thead><tr><th>Race</th><th>Rating</th><th>Faction</th><th>Party money for Democrat, per adult</th><th>All outside money against, per adult</th><th>Party matched</th></tr></thead>
    <tbody>{senateMoneyRows.map((r) => <tr><td>{r.st} {r.dem}</td><td>{r.rating}</td><td>{FACTION[r.faction].label}</td><td>{usd(r.party)}</td><td>{usd(r.against)}</td><td>{r.against > 0.05 ? pct((r.party / r.against) * 100) : 'n/a'}</td></tr>)}</tbody></table>
</Figure>
<p>Read the chart row by row. The coloured mark is what the party's own network spent for the Democrat, and the grey tick is what all outside groups spent against them. The closer the two, the more of the attacks the party answered; the right column gives that as a percentage. In Michigan, for example, the party spent {usd(m('MI').party)} per adult for El-Sayed against {usd(m('MI').against)} spent against him, so it matched about {pct(share('MI'))}. It leaves out other pro-Democratic groups such as unions and EMILY's List, so a low figure doesn't mean the Democrat had no outside help.</p>
<p>Where the party decided a Senate race was winnable, <F f="progressive">progressive</F> nominees got large sums. Measured against what was spent attacking them, though, the party answered less for El-Sayed and Jackson than for most <F f="moderate">moderates</F> in close races.</p>
<ul>
<li><strong>Maine.</strong> Troy Jackson got {millions(m('ME').partyTotal)} from the party network, about {usd(m('ME').party, 0)} per adult, the {ordinal(partyRank)} rate of any race.</li>
<li><strong>Michigan.</strong> El-Sayed got {millions(m('MI').partyTotal)} counting every Senate Majority PAC affiliate and its share of Lower Costs Now. The often-quoted $46.5 million is WinSenate alone. On top of that, the DSCC spent $6.9 million in coordinated spending through mid-October. Party ads for him started 15 days after his primary.</li>
<li><strong>Timing.</strong> Jackson's party money started 37 days after his convention. Moderates nominated in spring waited longer after their nominations, but the party's Senate spending generally began in late August whoever the nominee was, so the gap mostly reflects the calendar.</li>
</ul>
<p>The critics have a point on the size of the match. Michigan is a big state and the other side spent heavily there, so El-Sayed's party money came to {usd(m('MI').party)} per adult. That covered only about {pct(share('MI'))} of the {millions(m('MI').againstTotal)} spent against him. Jackson's covered {pct(share('ME'))}. For the moderates in Toss-up races the party covered {pct(share('AK'))} in Alaska, {pct(share('IA'))} in Iowa and {pct(share('KS'))} in Kansas, and Chris Pappas in Lean D New Hampshire had {pct(share('NH'))} covered. Per adult, Maine still ranks near the top, because it is small; the share of attacks answered is the fairer comparison.</p>
<p>Peggy Flanagan got no party money in Minnesota, but neither side treated that race as close. Republican-aligned groups spent only about {millions(m('MN').againstTotal)} against her.</p>
<p>Angie Nixon in Florida is the strongest case for the critics. The party network and the DSCC spent nothing for her independently. She lost by {(m('FL').repPct - m('FL').demPct).toFixed(1)} points. Other Democratic-aligned groups did spend about $11.8 million for her, so "Democrats gave her nothing" goes too far. The viral claim that "Schumer gave her $5,000" seems to mix up a $5,000 contribution from Kirsten Gillibrand's leadership PAC, filed August 27.</p>
<p>Florida's size is part of the story. It has 18.8 million adults, so even Mississippi's thin {usd(m('MS').party, 0)} per adult would have cost about ${Math.round(18.8 * m('MS').party)} million there.</p>
<p>Nominees who weren't progressive were short-changed too.</p>
<ul>
<li>James Talarico got {usd(m('TX').party)} per adult against {usd(m('TX').against)} spent against him, the weakest match of any Toss-up race.</li>
<li>Annie Andrews won South Carolina with {usd(m('SC').party)} per adult of party money.</li>
<li>Scott Colom won Mississippi by {(m('MS').demPct - m('MS').repPct).toFixed(1)} points after a first party ad buy on October 21.</li>
<li>Jamie Davis lost Louisiana by under 2 points with no national party money at all.</li>
</ul>
<p>If the party map shows a pattern beyond competitiveness, it is regional and racial: Black nominees in the Deep South and Florida (Nixon, Davis, Colom) got the least. Nixon said as much herself: "people are being very hesitant in terms of funding Black women, especially in the South." Filings show where money went, not why.</p>
<p>Spending also has to be read against what a race usually costs. Counting everything spent in the race, Michigan cost 2.1 times its past Senate races per adult, about average for a Lean D race in 2026. Maine cost 1.9 times its past races. Minnesota cost three times its own cheap history but only about a quarter of the 2026 average for its rating. Texas cost nearly four times its history but a quarter of the Toss-up average, because the state is so large. Florida came in below its own history.</p>

<H id="house-money" level={3}>{T('house-money')}</H>
<Figure id="fig-house-money" legend={HOUSE_ROWS} hint="Press to highlight"
  caption="Democratic challengers and open-seat nominees in seats rated Toss-up, Lean or Likely. Money is DCCC coordinated spending through mid-October plus House Majority PAC independent spending through Election Day, per vote cast. The vertical tick is the moderate median in each row.">
  <HouseMoneyChart />
  <table slot="table"><thead><tr><th>Rating</th><th>Seat</th><th>Democrat</th><th>Faction</th><th>Party money per vote</th><th>Red to Blue</th><th>Result</th></tr></thead>
    <tbody>{houseMoneyRows.map((r) => <tr><td>{r.rating}</td><td>{r.code}</td><td>{r.dem}</td><td>{FACTION[r.faction].label}</td><td>{usd(r.perVote)}</td><td>{r.redToBlue ? 'yes' : 'no'}</td><td>{r.result}</td></tr>)}</tbody></table>
</Figure>
<p>In the House, three of the {w(nProgCompetitiveChallengers)} <F f="progressive">progressive</F> challengers in Toss-up and Lean seats got <em>more</em> party money per vote than the typical <F f="moderate">moderate</F>. Villegas in CA-22 got about {usd(hm('CA-22').perVote, 0)} per vote cast, the highest of any seat. Lawrence in MI-7 got about {usd(hm('MI-07').perVote, 0)} and Dunlap in ME-2 about {usd(hm('ME-02').perVote, 0)}. Moderate challengers had medians of about {usd(houseMoneyMedian('Toss-up'), 0)} in Toss-up seats and {usd(houseMoneyMedian('Lean'), 0)} in Lean seats. The fourth progressive, Tom Perriello in Lean VA-5, got none, although he made Red to Blue; only {w(leanMods.filter((r) => r.perVote < 0.01).length)} of the {leanMods.length} Lean moderates got nothing. A regression controlling for rating, 2024 margin and incumbency finds no penalty for the progressive flag, but with only {w(rtb.prog.n)} progressive challengers in competitive seats, that rests on very few cases.</p>
<p>Justin Pearson in TN-9 got no House Majority PAC money, but neither did several moderates in similar reach seats. Some late DCCC money for him and Perriello may also fall in the mid-October gap in the filings.</p>
<p>The DCCC's reluctance showed in endorsements and timing more than in money.</p>
<ul>
<li>Its May picks in CA-22 and ME-2, Jasmeet Bains and Joe Baldacci, both lost their primaries to progressives.</li>
<li>It added Villegas to its Red to Blue program on June 10, right after his primary (<a href="https://dccc.org/randy-villegas-added-to-dcccs-coveted-red-to-blue-program/">DCCC</a>).</li>
<li>Dunlap waited two months. The Portland Press Herald's headline was "National Democrats finally back Matt Dunlap," and the paper reported the DCCC "had not been on good terms" with him (<a href="https://www.pressherald.com/2026/08/20/national-democrats-finally-back-matt-dunlap-in-his-race-against-paul-lepage/">Press Herald</a>).</li>
<li>Lawrence was added six weeks after his primary. Hines in MI-10, a moderate nominated the same day, got in after one week.</li>
</ul>
<p>In the end, {rtb.prog.yes} of {rtb.prog.n} progressive challengers in competitive seats made Red to Blue, against {rtb.mod.yes} of {rtb.mod.n} moderates and {rtb.none.yes} of {rtb.none.n} nominees with no faction flag.</p>
<p>The nominees nobody helped were mostly unflagged. I looked at seats Trump won by at least 5 points in 2024 where the 2026 race was decided by under 5 points. {nobodyHelped.n} of them got less than $1 per vote of outside help: {nobodyHelped.unflagged} nominees with no faction flag, {w(nobodyHelped.moderate)} moderates and {nobodyHelped.progressive === 0 ? 'no' : nobodyHelped.progressive} progressive-flagged nominee{nobodyHelped.progressive === 1 ? '' : 's'}. LaKesha Womack (NC-14) and Victoria Broderick (TN-4) are among them. Both call themselves progressive, but no progressive group endorsed either. Womack won on about {thousands(receipts('NC-14'))} raised. Broderick, leading an uncalled race on under $100,000, said: "I'm not angry that I didn't get support because I got to just pull off a complete upset" (<a href="https://wpln.org/post/this-tennessee-democrat-ousted-an-eight-term-congressman-with-less-than-100k/">WPLN</a>). These were seats nobody expected to be close, not snubs by faction.</p>

<H id="progressive-groups" level={3}>{T('progressive-groups')}</H>
<p>The Working Families Party was the only progressive group that spent real money on general elections. It put about $1.9 million into Michigan's Senate race, about $0.2 million into Florida's and $1.65 million across nine House seats. Justice Democrats, DSA, Our Revolution and the PCCC reported no independent spending in any general election between a Democrat and a Republican.</p>
<p>In September a Democratic operative told Axios:</p>
<Quote who="An unnamed Democratic operative" source="Axios" href="https://www.axios.com/2026/09/22/senate-abdul-el-sayed-michigan-progressives" when="September 22">The so-called establishment wing of the Democratic Party is the only one spending for Abdul.</Quote>
<p>Progressive leaders mostly helped by moving money into the party's own channels. Alexandria Ocasio-Cortez transferred $1 million on October 16 to a joint fund run by El-Sayed, the DSCC and the Michigan Democratic Party (<a href="https://gvwire.com/2026/10/16/ocasio-cortez-transfers-1-million-to-help-el-sayed-in-final-sprint-in-michigan/">NYT via GV Wire</a>).</p>
<p>The heaviest factional spending came in the primaries instead, as the <a href="#leaders">section on the leaders</a> describes. AIPAC's super PAC, for example, spent $20.1 million against El-Sayed before his primary and only $0.76 million in the general.</p>

<H id="claims" level={3}>{T('claims')}</H>
<div class="table-wrap claims-wrap"><table class="claims">
<thead><tr><th>Claim</th><th>Made by</th><th>What the filings show</th></tr></thead>
<tbody>
<tr><td>The party didn't invest in progressive Senate nominees</td><td>Pressley, Nixon, many on X</td><td>True for Nixon in Florida, and for Flanagan in a race neither side contested. False for El-Sayed ({millions(m('MI').partyTotal)}) and Jackson ({millions(m('ME').partyTotal)}), though the party answered a smaller share of the attacks on them than on most moderates in close races.</td></tr>
<tr><td>The establishment is spending big on progressive insurgents</td><td>Bill Scher, Washington Monthly</td><td>Mostly true in target races. Villegas, Lawrence and Dunlap got more per vote than the moderate medians; Perriello got nothing.</td></tr>
<tr><td>Schumer spent $35 million while Sanders sat on his money</td><td>Neera Tanden</td><td>Roughly right as of mid-October. Senate Majority PAC's Michigan total was "nearly $35 million" (<a href="https://www.semafor.com/article/10/14/2026/top-democratic-super-pac-spends-more-in-michigan-maine">Semafor</a>). Progressive groups spent little in the general, though AOC moved $1M the same day.</td></tr>
<tr><td>Schumer gave Nixon only $5,000</td><td>Viral posts</td><td>Probably a mix-up. The $5,000 on file is from Gillibrand's leadership PAC. Punchbowl reported a gift from Schumer's PAC of unknown size, which later filings should show. The party network spent nothing for Nixon independently.</td></tr>
<tr><td>Progressive groups left their nominees on their own</td><td>Axios source, Tanden</td><td>Largely true in money terms. Only the Working Families Party spent meaningfully.</td></tr>
<tr><td>The money followed ideology</td><td>Implied by both sides</td><td>Not supported. It followed the party's target map. Non-progressives such as Talarico, Andrews and Colom also got little, and Black nominees in the South got the least.</td></tr>
</tbody></table></div>
<p>Download the money data: <a href="data/senate_money_2026.csv">Senate (CSV)</a> and <a href="data/house_money_2026.csv">House (CSV)</a>. Each row notes the coverage date of its figures.</p>

<H id="conclusion">{T('conclusion')}</H>
<p>The page set out to answer three questions. Here is where the evidence lands on each, as of the latest data.</p>
<ul>
<li><strong>What drove the wave?</strong> The national environment. It lifted every faction by about {Math.round(houseMeanAll)} points over Harris's 2024 margin.</li>
<li><strong>Do moderates do better?</strong> Possibly a little. In House races the estimates run {houseRange} and can't be told apart from zero. Statewide they point to an edge of about 1 to 6 points, resting on {w(statewideModel.nProg)} progressive nominees. An edge that size decided at most a handful of seats in a wave like this one, but it would matter more in a close year. Moderates won most of the flips mainly because they were the nominees in the seats that could flip.</li>
<li><strong>Did the party stand behind progressives?</strong> In the primaries, its leaders mostly backed moderates and incumbents and mostly lost, while the heavy spending against progressives came from AIPAC's super PAC, the crypto industry and dark-money groups, not from the leaders' super PACs. After the primaries, party money followed the target map: progressive nominees in winnable races got large sums, as much per vote as moderates in the House, though in the Senate the party answered a smaller share of the attacks on El-Sayed and Jackson than on most moderates. Those outside the map, along with Black nominees in the Deep South and Florida, got little. Progressive groups themselves spent almost nothing in general elections.</li>
</ul>
<p>Some of this will move. Certified counts may shift the House numbers slightly toward progressives, the December 3 FEC reports will fill in the last weeks of party spending, and the Senate leadership vote is still to come.</p>

<H id="data">{T('data')}</H>
<p>Download the data: <a href="data/house_2026.csv">House races (CSV)</a> and <a href="data/statewide_2026.csv">Senate and governor races (CSV)</a>. Each row lists its sources. The page checks once a day for new counts and filings and rebuilds when anything changes; an open page offers a reload when a newer version is out.</p>
<ul>
<li><strong>Results</strong> come from AP counts on NBC News pages. They are unofficial until certified. In the current data, {uncounted} House seats are under 95 percent counted and {uncalled} are uncalled. An uncalled seat counts as a flip, or a loss, by who leads. Alaska's at-large seat is left out, because the Republican's main opponent there was an independent, Bill Hill, not the Democratic nominee. California's late ballots usually lean Democratic and many progressives sit there, so final results may shift the House numbers slightly toward progressives.</li>
<li><strong>2024 presidential margins</strong> by district come from <a href="https://www.the-downballot.com/p/the-downballots-calculations-of-presidential">The Downballot's calculations</a> for the 2026 maps, which matters in California, Texas, North Carolina, Missouri, Ohio, Tennessee and Utah, where lines changed.</li>
<li><strong>Faction flags</strong> come from published endorsement lists and caucus rosters. No complete DSA, Our Revolution or WelcomePAC list exists, so some endorsees are missed, mostly long-shot challengers. {seats.filter((s) => s.faction === 'both').length} nominees carry both flags. Endorsements go mostly to candidates seen as viable, so "no flag" partly marks long shots rather than an ideology: {group('unflagged').nTrump} of the {group('unflagged').n} unflagged nominees ran in Trump seats.</li>
<li><strong>House models</strong> are ordinary least squares with heteroskedasticity-robust (HC1) standard errors and normal-approximation 95% intervals. Hispanic and college shares come from the 2024 American Community Survey and are only available for the {seats.filter((s) => s.hisp !== null && s.ba !== null).length} seats in states that kept their maps.</li>
<li><strong>Statewide coding</strong> uses Sanders and left-group endorsements and positions on Medicare for All, ICE, Israel and trans issues. James Talarico, Jon Ossoff and Sherrod Brown are coded mixed or unclear. Third Way counts Talarico, Ossoff and "Brown" (almost certainly Sherrod Brown) as moderates. Recoding all three that way moves the regression's progressive-versus-moderate gap from {fixed(statewideModel.vsModerate.est)} to {fixed(thirdWay.vsModerate.est)} points ({interval(thirdWay.vsModerate.lo, thirdWay.vsModerate.hi)}), and the average swing of moderates in competitive Senate races from {modCompetitiveMean.toFixed(1)} ({senateCompetitive.moderate.length} races) to {thirdWay.compModMean.toFixed(1)} ({thirdWay.compModN} races). Some moderate labels, including Pritzker, Healey and Kotek, are low-confidence, and the same-ballot section shows the result without them. The statewide model uses classical standard errors and rests on {w(statewideModel.nProg)} progressive nominees, so treat it as rough.</li>
<li><strong>Money</strong> comes from the FEC's bulk files: independent expenditures through the latest daily update, campaign receipts and party coordinated spending through mid-October until the post-general reports due December 3. Party money means the party committees and their allied super PAC networks; Lower Costs Now counts at 60 percent, Senate Majority PAC's share of its funding (FactCheck.org, as of October 14). Senate figures are per adult resident (2024 voting-age population), House figures per vote cast. Issue ads never appear in FEC data. The daily update keeps the published value if a running FEC total suddenly falls, which has so far caught one bad record.</li>
<li><strong>Party leaders.</strong> Filings for the leaders' own PACs stop in mid-summer 2026 in the data used here, so later gifts can't be checked yet. The leadership fights are described as of November 14, 2026.</li>
<li><strong>Missing evidence.</strong> No validated-voter or precinct study of 2026 exists yet. Those will separate turnout from persuasion.</li>
</ul>

